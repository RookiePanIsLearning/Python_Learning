    "# 模組 9：自動化排程與批次處理\n",
    "\n",
    "目標：用 time 模組定期印出時間。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "28dca0ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "from datetime import datetime\n",
    "\n",
    "for i in range(3):\n",
    "    print(f\"[{i+1}]\", datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"))\n",
    "    time.sleep(1)"
   ]
