   "source": [
    "# 模組 4：函式定義與變數作用域\n",
    "\n",
    "目標：撰寫帶有預設參數與 return 的函式。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "a6439c65",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hi, Pan!\n",
      "Hello, Pan!\n"
     ]
    }
   ],
   "source": [
    "def greet(name, prefix=\"Hi\"):\n",
    "    return f\"{prefix}, {name}!\"\n",
    "\n",
    "print(greet(\"Pan\"))\n",
    "print(greet(\"Pan\", prefix=\"Hello\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "53caf3ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = \"global\"\n",
    "\n",
    "def show_scope():\n",
    "    x = \"local\"\n",
    "    print(\"inside:\", x)\n",
    "\n",
    "show_scope()\n",
    "print(\"outside:\", x)"
   ]
  }
 ],
