   "source": [
    "# 模組 5：例外處理 (try/except)\n",
    "\n",
    "目標：練習捕捉常見錯誤並提供友善訊息。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44b4bfa7",
   "metadata": {},
   "outputs": [],
   "source": [
    "raw = \"10\"\n",
    "\n",
    "try:\n",
    "    value = int(raw)\n",
    "    result = 100 / value\n",
    "    print(\"result:\", result)\n",
    "except ValueError:\n",
    "    print(\"請輸入可轉為整數的內容\")\n",
    "except ZeroDivisionError:\n",
    "    print(\"不可除以 0\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3bd6e99a",
   "metadata": {},
