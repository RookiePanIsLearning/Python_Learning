   "source": [
    "# 模組 6：物件導向程式設計 (OOP)\n",
    "\n",
    "目標：定義基本 Class 與 `__init__`。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "212cfb50",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Dog:\n",
    "    def __init__(self, name, age):\n",
    "        self.name = name\n",
    "        self.age = age\n",
    "\n",
    "    def bark(self):\n",
    "        return f\"{self.name} says woof!\"\n",
    "\n",
    "d = Dog(\"Milo\", 3)\n",
    "print(d.bark())\n",
    "print(f\"name={d.name}, age={d.age}\")"
   ]
  }
 ],
